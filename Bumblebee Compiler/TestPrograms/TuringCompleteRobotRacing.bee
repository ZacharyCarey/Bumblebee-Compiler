const uint8 RIGHT = 0;
const uint8 DOWN = 1;
const uint8 LEFT = 2;
const uint8 UP = 3;

Hilbert(3, 3, 1);

void Hilbert(uint8 level, uint8 type, uint8 dir) {
	if (level == 0) {
		return;
	}

	Hilbert(level - 1, type + dir, -dir);
	output = type % 4;
	Hilbert(level - 1, type, dir);
	output = (type + dir) % 4;
	Hilbert(level - 1, type, dir);
	output = (type + (dir * 2)) % 4;
	Hilbert(level - 1, type - dir, -dir);
}